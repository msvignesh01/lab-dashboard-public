{
  "name": "lab-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude firebase/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --project lab-dashboard-rules-test --only firestore \"vitest run firebase/firestore.rules.test.js\"",
    "test:smoke": "node scripts/smoke-production.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "vercel-build": "npm run verify && npm run build",
    "migrate:hardening": "node --env-file=.env.local scripts/migrate-production-hardening.js",
    "grant:admin": "node --env-file=.env.local scripts/grant-admin.js",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.563.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "firebase-tools": "^15.19.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "protobufjs": "^7.6.1",
    "uuid": "^11.1.1"
  }
}
