rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The browser uses Firebase Authentication only. All application data is
    // read and mutated through the same-origin trusted API, whose Admin SDK
    // credentials bypass these rules. Keeping the client data plane closed
    // prevents raw profile, audit, maintenance, lock, and operational records
    // from bypassing server-side authorization, filtering, and redaction.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
