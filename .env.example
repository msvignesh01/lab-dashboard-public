# Public Firebase web configuration
# Firebase Console -> Project settings -> General -> Your apps -> Web app config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional; only needed if a future feature uses Firebase Storage.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Public canonical URL used for generated links and social metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Temporary migration fallback: next.config.mjs maps these legacy Vite names to
# their NEXT_PUBLIC_* equivalents only when the canonical value is absent.
# Remove these aliases after every deployment environment has migrated.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional transactional email for notifications. API format is Resend-compatible by default.
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
NOTIFICATION_FROM_EMAIL=AML Lab <no-reply@your-domain.example>
EMAIL_PROVIDER_ENDPOINT=https://api.resend.com/emails

# Required for trusted Vercel API routes that use Firebase Admin SDK
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Comma-separated verified admin emails. Changing this in Vercel requires a redeploy.
# Keep the committed example empty; set approved identities only in protected environments.
BOOTSTRAP_ADMIN_EMAILS=

# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Replace the values with your actual Firebase web app config
# 3. Set the Firebase Admin values before deploying trusted /api routes
# 4. Set BOOTSTRAP_ADMIN_EMAILS to one or more comma-separated verified admin emails for first setup
# 5. Never commit environment files or private keys to Git
